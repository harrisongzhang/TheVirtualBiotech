# Copy this file to .env in the repository root, then edit the values.
# These are .env entries. In a shell, use: export NAME="value"
# Exported variables take precedence over .env, including empty values.

# Required for live research; local doctor checks can skip this.
ANTHROPIC_API_KEY=""

# Required: absolute path to the downloaded Open Targets 25.09 directory.
OPEN_TARGETS_DATA_PATH="/absolute/path/to/open_targets"

# Required only for the web UI. Choose a private password; any username works.
BIOTECH_APP_PASSWORD=""

# Optional web port when 7860 is already occupied.
# GRADIO_SERVER_PORT="17860"

# Optional: directory containing prepared Tahoe data (see docs/TAHOE_SETUP.md).
# TAHOE_DATA_PATH="/absolute/path/to/tahoe-prepared"

# Optional writable MCP output directory (created automatically).
# MCP_OUTPUT_DIR="/absolute/path/to/mcp_outputs"
